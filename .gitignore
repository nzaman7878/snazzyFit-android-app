# ==========================================
# Snazzyfit .gitignore
# Covers Expo/React Native, Android, Node.js Backend
# ==========================================

# --- Dependencies ---
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- Environment & Sensitive Secret Files ---
.env
.env.*
*.env
!.env.example
!*/.env.example
*.pem
*.key
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# --- Expo & Metro ---
.expo/
*/.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# --- Android Build & Cache ---
/android
android/
.gradle/
build/
bin/
gen/
out/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties
key.properties
google-services.json

# --- iOS Build & Cache ---
/ios
ios/
Pods/
*.ipa
GoogleService-Info.plist

# --- TypeScript ---
*.tsbuildinfo

# --- Logs & Debugging ---
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# --- IDEs & OS Files ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.claude/
.idea/
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Temporary & Scratch ---
.temp/
tmp/
temp/
scratch/
example/
